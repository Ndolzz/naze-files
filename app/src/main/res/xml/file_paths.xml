<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Naze Files is a file manager with broad storage access (see
         MANAGE_EXTERNAL_STORAGE in the manifest), so shared content can live
         anywhere under a storage root - not just this app's sandbox. -->
    <root-path name="root_files" path="/" />
</paths>
